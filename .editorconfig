# EditorConfig for OLED Sleeper — https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Namespaces are block-scoped throughout (76 files to 1). Without this, the IDE
# suggests converting every file to file-scoped.
csharp_style_namespace_declarations = block_scoped:suggestion

# Language features in active use.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# `var` is used for locals with an obvious right-hand side and explicit types
# elsewhere. Both appear deliberately; no preference is enforced.
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

# Usings sit outside the namespace and are not grouped or sorted by System-first.
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = false

# Formatting violations are mechanical — `dotnet format` fixes them — but they
# stay out of the build output.
dotnet_diagnostic.IDE0055.severity = suggestion

# Nullable diagnostics keep their compiler defaults. There are 12 outstanding;
# see CLAUDE.md.

[*.xaml]
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2
